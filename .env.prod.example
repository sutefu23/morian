PROJECT_NAME=morian

# Lightsail Managed Database (MySQL 8.0) への接続URL
# 形式: mysql://<USER>:<PASSWORD>@<ENDPOINT>:3306/<DBNAME>?sslaccept=accept
# - ENDPOINT は Lightsail管理画面の Database → Connect details に表示される
# - 例: ls-abc123def.cmnxxxxx.ap-northeast-1.rds.amazonaws.com
# - PASSWORD に記号を含む場合は URL エンコード (例: @ → %40, # → %23)
API_DATABASE_URL=mysql://dbmasteruser:CHANGE_ME@ls-xxxx.xxxxx.ap-northeast-1.rds.amazonaws.com:3306/morian?sslaccept=accept

# HOST は CORS の origin 判定に使われる。フロントエンドのURLを入れること
HOST=https://morian.vercel.app
API_BASE_PATH=/api
# API_ORIGIN は現状コードでは未使用。将来用に新APIドメインを入れておく
API_ORIGIN=https://api.example.com

# Railway から引き継ぐ値 (新規生成すると既存パスワードが認証不可になるため SALT は必ず引き継ぐ)
API_JWT_SECRET=CHANGE_ME_random_long_secret
API_SALT=CHANGE_ME_bcrypt_format_salt_from_railway
DEFAULT_USER_PASS=CHANGE_ME_initial_admin_pass
